    title Diagramme de Déploiement

    Deployment_Node(docker_host, "Serveur Docker", "Linux") {
        Container(app, "Application Laravel", "php:8.2-fpm", "Application PHP-FPM")
        Container(webserver, "Serveur Web", "nginx:alpine", "Reverse Proxy Nginx")
        Container(database, "Base de Données", "PostgreSQL", "Base de données relationnelle")
        Container(node, "Build Assets", "node:20-alpine", "Compilation Vue.js et CSS")
    }

    Rel(webserver, app, "Proxies requêtes", "HTTP")
    Rel(app, database, "Accède", "TCP/IP")
    Rel(node, app, "Fournit assets", "Volume partagé")
